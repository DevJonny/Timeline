{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A zoomable, inspectable vertical timeline from the Stone Age to the present day.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "validate": "node scripts/validate-data.ts",
    "brief": "node scripts/author-brief.ts",
    "merge-staged": "node scripts/merge-staged.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.2.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  }
}
